# Copy to .env and fill in whichever key you have.
#
# NONE OF THESE ARE REQUIRED. With an empty .env the studio runs on Pollinations,
# which is free and needs no key at all. Every key below is optional and only
# adds another engine to the matrix.
#
# This file is for keys the OPERATOR configures on the server. A visitor to a
# deployed studio does not need it: the web UI has a key vault (Engine ->
# Manage keys) that stores their key in their own browser and sends it along
# with the one request that uses it. A key set here is used only when the
# request did not carry one.

# --- Engine selection -----------------------------------------------------
# pollinations | gemini | huggingface | stability | openai | mock | auto
# "auto" walks the list and picks the first engine that is actually usable.
IMAGESTUDIO_PROVIDER=auto

# --- Pollinations (default engine, FREE, NO KEY) --------------------------
# Nothing to set. An optional token only raises the rate limit.
# POLLINATIONS_TOKEN=
# Engine model: flux (default, higher quality) or turbo (faster)
# IMAGESTUDIO_POLLINATIONS_MODEL=flux

# --- Google Gemini (PAID: image models are not on the free tier) ----------
# Get one at https://aistudio.google.com/app/apikey - the project needs billing
# enabled, or generation fails after the key authenticates.
GEMINI_API_KEY=
# IMAGESTUDIO_GEMINI_MODEL=gemini-2.5-flash-image

# --- Hugging Face (FREE TIER, free token) ---------------------------------
# Get one at https://huggingface.co/settings/tokens (read scope is enough)
HF_TOKEN=
# IMAGESTUDIO_HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Stability AI (PAID credits, small trial grant) -----------------------
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=
# IMAGESTUDIO_STABILITY_MODEL=core        # core | ultra | sd3

# --- OpenAI gpt-image-1 (PAID) --------------------------------------------
# DALL-E 3 retired March 2026; this targets the gpt-image series.
OPENAI_API_KEY=
# IMAGESTUDIO_OPENAI_MODEL=gpt-image-1
# IMAGESTUDIO_OPENAI_QUALITY=high

# --- Local asset library --------------------------------------------------
# Where downloaded assets and manifest.jsonl live. Defaults to ./assets, and
# falls back to a temp directory if that path turns out to be read-only (which
# is what happens inside a serverless bundle). Point this at mounted storage to
# give a deployed studio a library that survives a cold start.
# IMAGESTUDIO_ASSETS=

# --- Serverless tuning ------------------------------------------------------
# Wall-clock budget for one batch, in seconds. The retry shield stops backing
# off once it would outlive this, so an exhausted quota reports a readable
# error instead of a gateway timeout. 0 = unbounded. Defaults to 52 when the
# VERCEL env var is present (vercel.json allows 60), 0 otherwise.
# IMAGESTUDIO_BUDGET_SECONDS=
